<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1" : la séquence est créée à l'installation et n'est plus
         écrasée lors des mises à jour du module (sinon le compteur repartirait). -->
    <data noupdate="1">
        <record id="seq_bike_rental" model="ir.sequence">
            <field name="name">Contrat de location</field>
            <!-- code : la clé utilisée par next_by_code() dans le modèle. -->
            <field name="code">bike.rental</field>
            <!-- Donne LOC/2026/0001, LOC/2026/0002, ... -->
            <field name="prefix">LOC/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
