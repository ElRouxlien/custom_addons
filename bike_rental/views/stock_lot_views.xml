<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Héritage de vue : on ajoute nos deux champs dans la fiche d'un numéro
         de série, sans toucher au fichier d'origine d'Odoo. -->
    <record id="stock_lot_view_form_inherit_bike_rental" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.bike.rental</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- On se place juste après le champ "ref" de la fiche d'origine. -->
            <field name="ref" position="after">
                <field name="is_rental_bike"/>
                <field name="rental_state" invisible="not is_rental_bike"/>
            </field>
        </field>
    </record>

    <!-- Liste de la flotte de location, avec le statut de chaque vélo. -->
    <record id="stock_lot_view_list_bike_rental" model="ir.ui.view">
        <field name="name">stock.lot.list.bike.rental</field>
        <field name="model">stock.lot</field>
        <!-- Priorité élevée = cette liste n'est pas celle par défaut ailleurs. -->
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="rental_state" widget="badge"
                       decoration-success="rental_state == 'available'"
                       decoration-warning="rental_state == 'rented'"/>
            </list>
        </field>
    </record>

    <record id="stock_lot_action_bike_rental" model="ir.actions.act_window">
        <field name="name">Vélos de location</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="stock_lot_view_list_bike_rental"/>
        <!-- On ne montre que la flotte de location. -->
        <field name="domain">[('is_rental_bike', '=', True)]</field>
        <!-- Un vélo créé depuis ce menu est coché "vélo de location" d'office. -->
        <field name="context">{'default_is_rental_bike': True}</field>
    </record>

</odoo>
