<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue liste : une ligne par contrat. -->
    <record id="bike_rental_view_list" model="ir.ui.view">
        <field name="name">bike.rental.list</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lot_id"/>
                <field name="warehouse_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="amount_total"/>
                <!-- widget badge : l'état s'affiche comme une pastille de couleur. -->
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'rented'"
                       decoration-success="state == 'returned'"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire : la fiche d'un contrat. -->
    <record id="bike_rental_view_form" model="ir.ui.view">
        <field name="name">bike.rental.form</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- name = la méthode Python appelée. invisible = quand cacher le bouton. -->
                    <button name="action_confirm" string="Confirmer" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" string="Départ du vélo" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <!-- type="action" : au lieu d'appeler une méthode, le bouton ouvre
                         l'assistant de retour. Le contexte lui indique le contrat courant. -->
                    <button name="%(bike_rental_return_action)d" string="Retour du vélo" type="action"
                            class="oe_highlight" invisible="state != 'rented'"
                            context="{'default_rental_id': id}"/>
                    <!-- Les boutons de facturation disparaissent une fois la facture créée. -->
                    <button name="action_create_invoice" string="Facturer la location" type="object"
                            invisible="state not in ('confirmed', 'rented', 'returned') or invoice_id"/>
                    <button name="action_create_damage_invoice" string="Facturer les dégâts" type="object"
                            invisible="state != 'returned' or damage_total == 0 or damage_invoice_id"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <!-- La barre d'étapes en haut à droite. "Annulé" n'y apparaît
                         que si le contrat est annulé. -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,rented,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="lot_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Période et prix">
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="duration"/>
                            <field name="daily_price" readonly="state != 'draft'"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <!-- Onglets en bas de la fiche. -->
                    <notebook>
                        <page string="États des lieux" name="checkups">
                            <field name="checkup_ids">
                                <!-- editable="bottom" : on ajoute une ligne directement
                                     dans le tableau, sans ouvrir de fenêtre. -->
                                <list editable="bottom">
                                    <field name="type"/>
                                    <field name="date"/>
                                    <field name="note"/>
                                    <field name="damage_note"/>
                                    <field name="damage_amount"/>
                                </list>
                            </field>
                            <group>
                                <field name="damage_total"/>
                            </group>
                        </page>
                        <page string="Caution" name="deposit">
                            <group>
                                <field name="deposit_type"/>
                                <!-- La case n'apparaît qu'une fois le vélo rendu. -->
                                <field name="deposit_returned" invisible="state != 'returned'"/>
                            </group>
                        </page>
                        <page string="Facturation" name="invoicing">
                            <group>
                                <!-- Un Many2one est cliquable : on ouvre la facture depuis ici. -->
                                <field name="invoice_id"/>
                                <field name="damage_invoice_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue recherche : ce qu'on peut taper dans la barre de recherche,
         et les filtres proposés. -->
    <record id="bike_rental_view_search" model="ir.ui.view">
        <field name="name">bike.rental.search</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lot_id"/>
                <filter name="filter_draft" string="Demandes" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_rented" string="En location" domain="[('state', '=', 'rented')]"/>
                <filter name="group_warehouse" string="Magasin" context="{'group_by': 'warehouse_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action : ce qui s'ouvre quand on clique sur le menu. -->
    <record id="bike_rental_action" model="ir.actions.act_window">
        <field name="name">Contrats de location</field>
        <field name="res_model">bike.rental</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
