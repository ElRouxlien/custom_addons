<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- La fenêtre de l'assistant de retour. -->
    <record id="bike_rental_return_view_form" model="ir.ui.view">
        <field name="name">bike.rental.return.form</field>
        <field name="model">bike.rental.return</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="rental_id" readonly="1"/>
                    <field name="note"/>
                </group>
                <group string="Dégâts (laisser vide s'il n'y en a pas)">
                    <field name="damage_note"/>
                    <field name="damage_amount"/>
                </group>
                <footer>
                    <button name="action_validate" string="Valider le retour" type="object" class="oe_highlight"/>
                    <!-- special="cancel" : ferme la fenêtre sans rien enregistrer. -->
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- target="new" : l'action s'ouvre dans une fenêtre par-dessus l'écran. -->
    <record id="bike_rental_return_action" model="ir.actions.act_window">
        <field name="name">Retour du vélo</field>
        <field name="res_model">bike.rental.return</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
