<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La rubrique "Location" dans l'écran des droits d'un utilisateur. -->
    <record id="res_groups_privilege_bike_rental" model="res.groups.privilege">
        <field name="name">Location</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Groupe du vendeur : il crée et suit les contrats. -->
    <record id="group_bike_rental_user" model="res.groups">
        <field name="name">Vendeur</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_bike_rental"/>
        <!-- implied_ids : un vendeur est aussi un utilisateur interne. -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Groupe du gérant : il a tous les droits du vendeur, plus la suppression. -->
    <record id="group_bike_rental_manager" model="res.groups">
        <field name="name">Gérant</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_bike_rental"/>
        <field name="implied_ids" eval="[(4, ref('group_bike_rental_user'))]"/>
        <!-- L'administrateur est gérant d'office, sinon il ne verrait pas le menu. -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
