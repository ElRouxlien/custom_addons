<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste -->
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sold" type="object" string="Vendu"
                            class="btn-primary"
                            invisible="state in ('sold', 'canceled')"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('sold', 'canceled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du bien"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Prix">
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                        </group>
                        <group string="État">
                            <field name="state"/>
                            <field name="date_availability"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state"/>
                <filter name="filter_new" string="Nouveaux"
                        domain="[('state', '=', 'new')]"/>
                <filter name="filter_available" string="Disponibles"
                        domain="[('state', 'in', ('new', 'offer_received'))]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Biens Immobiliers</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>